    <div class="gallery-label">
      AMBALAPPARA
      <span>// ${number}</span>
    </div>

  `;

  galleryTrack.appendChild(card);

}


const gallery =
  document.getElementById("gallery");

const galleryProgress =
  document.getElementById("galleryProgress");

const galleryCurrent =
  document.getElementById("galleryCurrent");


function updateGallery(){

  const rect =
    gallery.getBoundingClientRect();

  const total =
    gallery.scrollHeight -
    window.innerHeight;

  if(total <= 0) return;

  const progress =
    Math.min(
      1,
      Math.max(
        0,
        -rect.top / total
      )
    );

  const travel =
    galleryTrack.scrollWidth -
    window.innerWidth;

  galleryTrack.style.transform =
    `translate3d(${-travel * progress}px,0,0)`;

  galleryProgress.style.width =
    `${progress * 100}%`;

  const current =
    Math.min(
      15,
      Math.floor(progress * 15) + 1
    );

  galleryCurrent.textContent =
    String(current).padStart(2,"0");

}

window.addEventListener(
  "scroll",
  updateGallery,
  {passive:true}
);

window.addEventListener(
  "resize",
  updateGallery
);

setTimeout(
  updateGallery,
  1000
);


/* =========================================================
   MAGIC
========================================================= */

const magicButton =
  document.getElementById("magicButton");

const magicContent =
  document.getElementById("magicContent");

const friendStage =
  document.getElementById("friendStage");

const scan =
  document.getElementById("scan");

