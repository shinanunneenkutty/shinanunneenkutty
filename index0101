    magicMute.textContent =
      audioMuted
        ? "♫ SOUND OFF"
        : "♫ SOUND ON";

  }
);


/* =========================================================
   TOUCH / CURSOR REACTION
========================================================= */

function reactToPointer(x,y){

  if(!magicPlayed) return;

  const friends =
    document.querySelectorAll(".friend");

  friends.forEach(friend => {

    const rect =
      friend.getBoundingClientRect();

    const centerX =
      rect.left + rect.width/2;

    const centerY =
      rect.top + rect.height/2;

    const dx =
      (x-centerX)/120;

    const dy =
      (y-centerY)/120;

    const mx =
      Math.max(
        -10,
        Math.min(10,dx)
      );

    const my =
      Math.max(
        -10,
        Math.min(10,dy)
      );

    friend.style.marginLeft =
      mx+"px";

    friend.style.marginTop =
      my+"px";

  });

}

window.addEventListener(
  "pointermove",
  e => {

    reactToPointer(
      e.clientX,
      e.clientY
    );

  },
  {passive:true}
);


