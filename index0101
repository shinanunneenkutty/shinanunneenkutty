  document.getElementById("magicAudio");

const magicMute =
  document.getElementById("magicMute");


let magicPlayed =
  false;

let audioMuted =
  false;


/* =========================================================
   ENTRY DIRECTIONS
========================================================= */

const DIRECTIONS = [

  [-42,-62,-35,.55],
  [43,-60,28,.72],
  [-45,10,-25,.62],
  [44,18,35,.76],
  [-35,55,50,.70],
  [35,55,-45,.64],
  [-52,-5,18,.68],
  [50,-15,-30,.82],
  [-12,-72,42,.62],
  [12,72,-42,.72],
  [-58,35,15,.65],
  [58,-38,-20,.78],
  [0,-78,8,.68]

];


/* =========================================================
   CREATE FRIEND
========================================================= */

function createFriend(index){

  const name =
    FRIENDS[index-1];

  const number =
    String(index).padStart(2,"0");

  const friend =
    document.createElement("div");

  friend.className =
    "friend";

  friend.innerHTML = `

    <img
      src="./public/images/friends/friend-${number}.png"
      alt="${name}"
    >

    <div class="friend-name">
      ${name.toUpperCase()}
    </div>

  `;

  friendStage.appendChild(friend);

  return friend;

}


/* =========================================================
   ANIMATE FRIEND
========================================================= */

function revealFriend(index){

  return new Promise(resolve => {

    const friend =
      createFriend(index);

    const direction =
      DIRECTIONS[index-1];

    const startX =
      direction[0];

    const startY =
      direction[1];

    const startRotation =
      direction[2];

    const startScale =
      direction[3];


    friend.style.left =
      "50%";

    friend.style.top =
      "50%";

    friend.style.opacity =
      "0";

    friend.style.transform =
      `translate(-50%,-50%)
       translate(${startX}vw,${startY}vh)
       rotate(${startRotation}deg)
       scale(${startScale})`;


    requestAnimationFrame(() => {

      friend.style.transition =
        "transform 1.05s cubic-bezier(.08,.9,.16,1),opacity .45s ease";

      friend.style.opacity =
        "1";

      const finalX =
        (Math.random()-.5)*48;

      const finalY =
        (Math.random()-.5)*35;

      const finalRotation =
        (Math.random()-.5)*22;


      friend.style.transform =
        `translate(-50%,-50%)
         translate(${finalX}vw,${finalY}vh)
         rotate(${finalRotation}deg)
         scale(1)`;

    });


    setTimeout(() => {

      /* little bounce */

      friend.style.transition =
        "transform .45s cubic-bezier(.2,1.5,.3,1)";

      friend.style.transform +=
        " scale(1.08)";


      setTimeout(() => {

        friend.style.transition =
          "transform .35s cubic-bezier(.2,.8,.2,1)";

        friend.style.transform =
          friend.style.transform
            .replace("scale(1.08)","scale(1)");

      },180);


    },850);


    setTimeout(
      resolve,
      1250
    );

  });

}


/* =========================================================
   MAGIC SEQUENCE
========================================================= */

async function startMagic(){

  if(magicPlayed) return;

  magicPlayed = true;

  document.body.classList.add("locked");

  magicContent.classList.add("hide");

  magicHud.classList.add("active");

  magicMute.classList.add("show");

  scan.classList.add("active");

  magicMessage.textContent =
    "INITIALIZING UNNECESSARY CHAOS";


  /* Audio starts after user interaction */

  try{

    audio.currentTime = 0;

    await audio.play();

  }catch(error){

    console.log(
      "Audio unavailable:",
      error
    );

  }


  await wait(800);


  /* ======================================================
     REVEAL 13 FRIENDS
  ====================================================== */

  for(
    let i=1;
    i<=FRIENDS.length;
    i++
  ){

    const name =
      FRIENDS[i-1];

    magicCount.textContent =
      `${String(i).padStart(2,"0")} / 13`;

    magicMessage.textContent =
      i === 1
        ? `${name.toUpperCase()} ACQUIRED`
        : `${name.toUpperCase()} DETECTED`;


    await revealFriend(i);


    if(i < FRIENDS.length){

      await wait(180);

    }

  }


  /* ======================================================
     FINISH
  ====================================================== */

  magicMessage.textContent =
    "ALL SUBJECTS ACCOUNTED FOR";

  await wait(500);

  magicEnd.classList.add("show");


  await wait(4000);

  magicEnd.classList.remove("show");

  magicMessage.textContent =
    "SYSTEM STABLE";

  document.body.classList.remove("locked");

}


function wait(ms){

  return new Promise(
    resolve => setTimeout(resolve,ms)
  );

}


magicButton.addEventListener(
  "click",
  startMagic
);


/* =========================================================
   MUTE
========================================================= */

magicMute.addEventListener(
  "click",
  () => {

    audioMuted =
      !audioMuted;

    audio.muted =
